{
  "private": true,
  "workspaces": [
    "dashboard/dashboard-web",
    "dashboard/server"
  ],
  "scripts": {
    "dev:web": "npm --prefix dashboard/dashboard-web run dev",
    "dev:server": "npm --prefix dashboard/server start",
    "dev:demo": "node -e \"const r=require('child_process').spawnSync('dashboard/demo-server/venv/Scripts/python.exe',['dashboard/demo-server/wrongway_detector.py'],{stdio:'inherit'}); process.exit(r.status ?? 1);\"",
    "db:deploy": "npm --prefix dashboard/server run db:deploy",
    "db:generate": "npm --prefix dashboard/server run db:generate",
    "db:migrate": "npm --prefix dashboard/server run db:migrate",
    "db:seed": "npm --prefix dashboard/server run db:seed",
    "db:status": "npm --prefix dashboard/server run db:status",
    "db:studio": "npm --prefix dashboard/server run db:studio",
    "build:web": "npm --prefix dashboard/dashboard-web run build",
    "check:server": "node dashboard/server/scripts/check-syntax.js",
    "verify:control-board-protocol": "node dashboard/server/scripts/verify-control-board-protocol.js",
    "verify:control-board-tcp": "node dashboard/server/scripts/verify-control-board-tcp-loopback.js",
    "verify:auth-crypto": "node dashboard/server/scripts/verify-auth-crypto.js",
    "verify:swagger-contracts": "node dashboard/server/scripts/verify-swagger-contracts.js",
    "smoke": "npm run verify:control-board-protocol && npm run verify:control-board-tcp && npm run verify:auth-crypto && npm run verify:swagger-contracts && npm run check:server",
    "ci": "npm run build:web && npm run check:server",
    "setup:demo": "python -m venv dashboard/demo-server/venv && \"dashboard\\demo-server\\venv\\Scripts\\python.exe\" -m pip install -r dashboard/demo-server/requirements.txt"
  }
}
