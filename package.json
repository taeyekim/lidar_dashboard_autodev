{
  "private": true,
  "workspaces": [
    "dashboard/dashboard-web",
    "dashboard/server"
  ],
  "scripts": {
    "dev:web": "npm --prefix dashboard/dashboard-web run dev",
    "dev:server": "npm --prefix dashboard/server start",
    "dev:demo": "node -e \"const r=require('child_process').spawnSync('dashboard/demo-server/venv/Scripts/python.exe',['dashboard/demo-server/wrongway_detector.py'],{stdio:'inherit'}); process.exit(r.status ?? 1);\"",
    "db:deploy": "npm --prefix dashboard/server run db:deploy",
    "db:generate": "npm --prefix dashboard/server run db:generate",
    "db:migrate": "npm --prefix dashboard/server run db:migrate",
    "db:seed": "npm --prefix dashboard/server run db:seed",
    "db:status": "npm --prefix dashboard/server run db:status",
    "db:studio": "npm --prefix dashboard/server run db:studio",
    "build:web": "npm --prefix dashboard/dashboard-web run build",
    "check:server": "node dashboard/server/scripts/check-syntax.js",
    "ci:db": "npm run db:deploy && npm run db:seed && npm run db:status",
    "verify:control-board-protocol": "node dashboard/server/scripts/verify-control-board-protocol.js",
    "verify:control-board-tcp": "node dashboard/server/scripts/verify-control-board-tcp-loopback.js",
    "verify:manual-control-command": "node dashboard/server/scripts/verify-manual-control-command.js",
    "verify:auth-crypto": "node dashboard/server/scripts/verify-auth-crypto.js",
    "verify:auth-cookie": "node dashboard/server/scripts/verify-auth-cookie-contracts.js",
    "verify:auth-runtime": "node dashboard/server/scripts/verify-auth-runtime-contracts.js",
    "verify:device-ingest-key": "node dashboard/server/scripts/verify-device-ingest-key.js",
    "verify:swagger-contracts": "node dashboard/server/scripts/verify-swagger-contracts.js",
    "verify:statistics-contracts": "node dashboard/server/scripts/verify-statistics-contracts.js",
    "verify:frontend-ui-contracts": "node dashboard/server/scripts/verify-frontend-ui-contracts.js",
    "verify:frontend-settings-contracts": "node dashboard/server/scripts/verify-frontend-settings-contracts.js",
    "verify:realtime-contracts": "node dashboard/server/scripts/verify-realtime-contracts.js",
    "verify:wrongway-contracts": "node dashboard/server/scripts/verify-wrongway-contracts.js",
    "verify:delivery-proxy-contracts": "node dashboard/server/scripts/verify-delivery-proxy-contracts.js",
    "verify:delivery-evidence-matrix": "node dashboard/server/scripts/verify-delivery-evidence-matrix.js",
    "verify:env-contracts": "node dashboard/server/scripts/verify-env-contracts.js",
    "verify:github-actions-contracts": "node dashboard/server/scripts/verify-github-actions-contracts.js",
    "verify:audit-policy": "node dashboard/server/scripts/verify-audit-policy.js",
    "server:test": "npm --prefix dashboard/server test",
    "security:evidence": "node dashboard/server/scripts/generate-security-evidence.js",
    "runtime:evidence": "node dashboard/server/scripts/generate-runtime-evidence.js",
    "delivery:evidence": "node dashboard/server/scripts/generate-delivery-evidence.js",
    "smoke": "npm run verify:control-board-protocol && npm run verify:control-board-tcp && npm run verify:manual-control-command && npm run verify:auth-crypto && npm run verify:auth-cookie && npm run verify:auth-runtime && npm run verify:device-ingest-key && npm run verify:swagger-contracts && npm run verify:statistics-contracts && npm run verify:frontend-ui-contracts && npm run verify:frontend-settings-contracts && npm run verify:realtime-contracts && npm run verify:wrongway-contracts && npm run verify:delivery-proxy-contracts && npm run verify:delivery-evidence-matrix && npm run verify:env-contracts && npm run verify:github-actions-contracts && npm run check:server",
    "ci": "npm run build:web && npm run check:server",
    "delivery:verify": "npm run smoke && npm run server:test && npm --prefix dashboard/dashboard-web run lint && npm run ci && npm run verify:audit-policy && docker compose config --quiet",
    "setup:demo": "python -m venv dashboard/demo-server/venv && \"dashboard\\demo-server\\venv\\Scripts\\python.exe\" -m pip install -r dashboard/demo-server/requirements.txt"
  }
}
