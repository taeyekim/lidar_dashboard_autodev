# Base ports used by local scripts and Docker Compose.
FRONTEND_PORT=5173
DASHBOARD_PORT=5000
DETECTOR_PORT=8888
NGINX_PORT=8080

# Browser and external client access host.
# Use localhost for same-PC development.
# For field or equipment integration tests, set this to the dashboard PC IP address.
PUBLIC_HOST=localhost

# Vite frontend environment variables.
# Only VITE_ prefixed values are exposed to browser code.
VITE_API_HOST=localhost
VITE_API_PORT=5000
VITE_DETECTOR_HOST=localhost
VITE_DETECTOR_PORT=8888
VITE_API_BASE_URL=http://localhost:5000
VITE_WS_BASE_URL=ws://localhost:5000/ws
VITE_DETECTOR_BASE_URL=http://localhost:8888
VITE_AUTH_CSRF_COOKIE_NAME=lidar_dashboard_csrf

# Backend security defaults.
# Use comma-separated origins. Leave unset for localhost/Nginx development defaults.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
JSON_BODY_LIMIT=1mb
TRUST_PROXY=loopback
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
MUTATION_RATE_LIMIT_WINDOW_MS=60000
MUTATION_RATE_LIMIT_MAX=120
# Optional comma-separated device ingest keys. Leave blank for trusted isolated LAN development.
# When set, POST /api/wrongway and /api/ingest/* require the X-Device-Key header.
DEVICE_INGEST_API_KEY=

# Dashboard-side wrong-way level-2 escalation.
# Keep disabled until field measurement criteria are approved.
WRONGWAY_LEVEL2_ESCALATION_ENABLED=false
WRONGWAY_LEVEL2_MIN_CONSECUTIVE_COUNT=
WRONGWAY_LEVEL2_MIN_CONFIDENCE=

# Service host names used for Docker Compose internal networking.
# Set COMPOSE_DETECTOR_HOST=demo-server only when the demo detector runs inside Compose.
COMPOSE_BACKEND_HOST=backend
COMPOSE_DETECTOR_HOST=host.docker.internal

# Legacy serial settings retained for diagnostics.
SERIAL_PORT=
BAUD_RATE=9600

# Demo server video source used for local AI detection tests.
VIDEO_SOURCE=../dashboard-web/public/wrongway_test.mp4

# Docker Compose PostgreSQL development database settings.
# Keep the DB name and account name distinct for easier operations checks.
POSTGRES_DB=lidar_dashboard_db
POSTGRES_USER=lidar_dashboard_user
POSTGRES_PASSWORD=example_password
POSTGRES_PORT=5433

# PostgreSQL URL used by the local Prisma CLI.
# Keep it aligned with the POSTGRES_* values above.
DATABASE_URL=postgresql://lidar_dashboard_user:example_password@localhost:5433/lidar_dashboard_db?schema=public

# Integrated control board TCP command channel.
# Keep dry-run enabled until the real board IP/port is confirmed on the field LAN.
CONTROL_BOARD_TRANSPORT=tcp
CONTROL_BOARD_DRY_RUN=true
CONTROL_BOARD_LIVE_APPROVED=false
CONTROL_BOARD_HOST=
CONTROL_BOARD_PORT=
CONTROL_BOARD_CONNECT_TIMEOUT_MS=1000
CONTROL_BOARD_RESPONSE_TIMEOUT_MS=1000
CONTROL_BOARD_RETRY_COUNT=1
CONTROL_BOARD_HEARTBEAT_INTERVAL_MS=5000

# Operator authentication.
# Use a long random JWT_SECRET in delivery/production environments.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=lidar_dashboard_access
AUTH_CSRF_COOKIE_NAME=lidar_dashboard_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE_MS=28800000
SEED_ADMIN_USER_ID=admin
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_ADMIN_NAME=System Administrator

# Nginx reverse proxy delivery defaults.
NGINX_CLIENT_MAX_BODY_SIZE=2m
NGINX_PROXY_CONNECT_TIMEOUT=5s
NGINX_PROXY_SEND_TIMEOUT=30s
NGINX_PROXY_READ_TIMEOUT=65s
NGINX_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' http: https: ws: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
NGINX_WRONGWAY_RATE_LIMIT=30r/s
NGINX_WRONGWAY_BURST=60
# Use a CIDR such as 192.168.0.0/24 before delivery if Swagger should be restricted.
NGINX_SWAGGER_ALLOW=all
